{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "deploymentReady", "image", "service", "ingress", "media", "resources"],
  "definitions": {
    "cpuQuantity": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*(?:\\.[0-9]{1,3})?|0\\.(?:[1-9][0-9]{0,2}|0[1-9][0-9]?|00[1-9]))$"
    },
    "memoryQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:Ki|Mi|Gi|Ti|Pi|Ei|k|K|M|G|T|P|E)?$"
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"$ref": "#/definitions/cpuQuantity"},
        "memory": {"$ref": "#/definitions/memoryQuantity"}
      }
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    }
  },
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 2},
    "deploymentReady": {"type": "boolean"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "const": "ghcr.io/snaraj/hospedajedonlolo-com"},
        "tag": {
          "type": "string",
          "description": "Release tag rendered before the digest for legibility only; the digest is what Kubernetes resolves and cosign verifies.",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {"port": {"type": "integer", "const": 8080}}
    },
    "ingress": {
      "type": "object",
      "description": "The only peer allowed to reach the origin. All three facts are required so the NetworkPolicy can never admit more than one connector.",
      "additionalProperties": false,
      "required": ["peerNamespace", "peerAppName", "peerInstance"],
      "properties": {
        "peerNamespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"},
        "peerAppName": {"$ref": "#/definitions/label"},
        "peerInstance": {"$ref": "#/definitions/label", "minLength": 1}
      }
    },
    "media": {
      "type": "object",
      "description": "The operator-provisioned read-only claim holding the pinned media. Media is not optional: the origin refuses to start without it.",
      "additionalProperties": false,
      "required": ["claimName", "mountPath", "maxConcurrent"],
      "properties": {
        "claimName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,251}[a-z0-9])?$"},
        "mountPath": {"type": "string", "pattern": "^(/[A-Za-z0-9][A-Za-z0-9._-]*)+$", "not": {"enum": ["/tmp"]}},
        "maxConcurrent": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      }
    }
  }
}
